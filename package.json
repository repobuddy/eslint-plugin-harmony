{
	"name": "eslint-plugin-harmony",
	"version": "8.0.0",
	"description": "eslint config that works in harmony with different IDEs",
	"keywords": [
		"eslint",
		"eslint-plugin",
		"eslintplugin",
		"javascript",
		"prettier",
		"styleguide",
		"tslint",
		"typescript"
	],
	"homepage": "https://github.com/repobuddy/eslint-plugin-harmony",
	"bugs": {
		"url": "https://github.com/repobuddy/eslint-plugin-harmony/issues"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/repobuddy/eslint-plugin-harmony"
	},
	"license": "MIT",
	"author": "Unional",
	"type": "module",
	"main": "lib/index.js",
	"types": "lib/index.d.ts",
	"exports": {
		".": {
			"types": "./lib/index.d.ts",
			"default": "./lib/index.js"
		},
		"./package.json": "./package.json"
	},
	"files": [
		"lib",
		"ide-configs"
	],
	"scripts": {
		"build": "tsc -p tsconfig.lib.json",
		"build:watch": "tsc -w",
		"lint": "eslint --ext=js,ts src",
		"nuke": "rimraf lib node_modules",
		"prepare": "husky",
		"prettier": "prettier spec/ts-prettier/**/*.pass.ts --write",
		"test": "vitest run",
		"test:watch": "vitest",
		"typecheck": "tsc -p tsconfig.check.json",
		"verify": "pnpm build && pnpm typecheck && pnpm lint && pnpm test",
		"version": "changeset version",
		"release": "changeset publish",
		"cs": "changeset"
	},
	"dependencies": {
		"@typescript-eslint/utils": "^8.0.0"
	},
	"devDependencies": {
		"@changesets/cli": "^3.0.0",
		"@commitlint/cli": "21.2.2",
		"@commitlint/config-conventional": "21.2.2",
		"@types/eslint": "^9.6.1",
		"@types/node": "24.13.4",
		"@typescript-eslint/eslint-plugin": "^8.69.0",
		"@typescript-eslint/parser": "^8.69.0",
		"eslint": "8.57.1",
		"eslint-config-prettier": "^10.0.0",
		"eslint-plugin-harmony": "link:.",
		"husky": "9.1.7",
		"prettier": "3.9.6",
		"rimraf": "6.1.3",
		"typescript": "5.9.3",
		"vitest": "4.1.11"
	},
	"peerDependencies": {
		"@typescript-eslint/eslint-plugin": ">= 6.0.0",
		"@typescript-eslint/parser": ">= 6.0.0",
		"eslint": ">=8.57.0",
		"eslint-config-prettier": ">= 9.0.0"
	},
	"peerDependenciesMeta": {
		"@typescript-eslint/eslint-plugin": {
			"optional": true
		},
		"@typescript-eslint/parser": {
			"optional": true
		},
		"eslint-config-prettier": {
			"optional": true
		}
	},
	"packageManager": "pnpm@11.25.0",
	"engines": {
		"node": "^20.19.0 || ^22.13.0 || >=24"
	}
}
